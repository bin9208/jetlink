<?xml version="1.0" encoding="utf-8"?>
<!-- The test app only: a benchmark started from `adb shell`, for runs over
     wireless debugging. android.permission.DUMP is held by the shell and the
     system, never by an app, so nothing on the phone but adb can send it:
     adb shell am broadcast -a io.zoompilot.jetlink.BENCHMARK -p io.zoompilot.jetlink.android.carrot.test (extra int "seconds", default 60) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".BenchmarkReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.zoompilot.jetlink.BENCHMARK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
