@@ -12,6 +12,7 @@
 // See the License for the specific language governing permissions and
 // limitations under the License.
 
+#include <cstdlib>
 #include "litert/vendors/mediatek/dispatch/litert_dispatch_invocation_context.h"
 
 #include <array>
@@ -323,6 +324,24 @@ LiteRtDispatchInvocationContextT::Create(
                          "Failed to set execution boost hint");
   }
 
+  // Jetlink Carrot: NeuroPilot's real-time deadline (ms) and CPU cache flush
+  // hint, from the environment, for timing what they do on a Dimensity's APU.
+  if (const char* deadline = std::getenv("JETLINK_NEURON_DEADLINE");
+      deadline != nullptr && neuron_adapter_api.api().execution_set_deadline) {
+    int status = neuron_adapter_api.api().execution_set_deadline(
+        execution->get(), static_cast<uint16_t>(std::atoi(deadline)));
+    LITERT_LOG(LITERT_INFO, "NeuronExecution_setDeadline(%s): %d", deadline,
+               status);
+  }
+  if (const char* flush = std::getenv("JETLINK_NEURON_CACHE_FLUSH");
+      flush != nullptr &&
+      neuron_adapter_api.api().execution_set_cache_flush_hint) {
+    int status = neuron_adapter_api.api().execution_set_cache_flush_hint(
+        execution->get(), static_cast<uint8_t>(std::atoi(flush)));
+    LITERT_LOG(LITERT_INFO, "NeuronExecution_setCacheFlushHint(%s): %d", flush,
+               status);
+  }
+
   return Ptr(new LiteRtDispatchInvocationContextT(
       neuron_adapter_api, device_context, model.release(),
       compilation.release(), execution->release(), num_inputs, num_outputs));
